# 此文件仅定义未来本地开发的配置边界；不要在此填写真实密钥。

# 服务运行环境与 HTTP 地址
MEASURETRAIL_ENV=development
MEASURETRAIL_API_PORT=21000
MEASURETRAIL_PUBLIC_BASE_URL=http://localhost:21000
# 浏览器客户端来源，逗号分隔；留空时默认使用 MEASURETRAIL_PUBLIC_BASE_URL。
MEASURETRAIL_CORS_ORIGINS=http://localhost:21000
# Vue/React 构建产物目录；Docker 镜像固定使用 /app/web。
MEASURETRAIL_WEB_ROOT=../web/dist

# SQLite
MEASURETRAIL_SQLITE_PATH=/app/data/measuretrail.sqlite
MEASURETRAIL_SQLITE_BUSY_TIMEOUT_MS=5000
MEASURETRAIL_BACKUP_DIR=/app/backups

# 认证（部署前必须替换为高熵随机值）
MEASURETRAIL_DEFAULT_USERNAME=admin
MEASURETRAIL_DEFAULT_PASSWORD=111111
MEASURETRAIL_JWT_ISSUER=measuretrail
MEASURETRAIL_JWT_AUDIENCE=measuretrail-ios
MEASURETRAIL_JWT_ACCESS_SECRET=CHANGE_ME_BEFORE_DEPLOYMENT
MEASURETRAIL_JWT_REFRESH_SECRET=CHANGE_ME_BEFORE_DEPLOYMENT

# Sign in with Apple（未启用时留空；启用后以下五项必须一并配置）
MEASURETRAIL_APPLE_TEAM_ID=
MEASURETRAIL_APPLE_KEY_ID=
MEASURETRAIL_APPLE_CLIENT_ID=
MEASURETRAIL_APPLE_PRIVATE_KEY=
# 使用 32-byte 随机值的标准或无填充 base64 编码，专门用于加密保存 Apple refresh token。
MEASURETRAIL_APPLE_CREDENTIAL_ENCRYPTION_KEY=
MEASURETRAIL_APPLE_JWKS_URL=https://appleid.apple.com/auth/keys
MEASURETRAIL_APPLE_TOKEN_URL=https://appleid.apple.com/auth/token
MEASURETRAIL_APPLE_REVOKE_URL=https://appleid.apple.com/auth/revoke
